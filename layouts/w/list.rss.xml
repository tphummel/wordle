{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\" ?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content in {{ .Title }} on {{ .Site.Title }}</description>
    <generator>Hugo</generator>
    <language>{{ .Site.LanguageCode }}</language>
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml" />
    {{ range .Pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ dict
          "puzzleNumber" (index .Params.puzzles 0)
          "date" .Params.state.puzzleDate
          "guesses" .Params.state.rowIndex
          "outcome" .Params.state.gameStatus
          "hardMode" .Params.state.hardMode
          "solution" .Params.state.solution
          "opener" (index .Params.openers 0)
          "words" .Params.words
          "hash" (index .Params.hashes 0)
          "link" .Permalink
        | jsonify }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
